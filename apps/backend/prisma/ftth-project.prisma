model FtthProject {
    id String @id @db.Uuid

    work Work @relation(fields: [id], references: [id])

    createdAt DateTime @default(now())

    contact String?

    hp Int

    survey   FtthSurvey? @relation(fields: [surveyId], references: [id])
    surveyId String?     @db.Uuid

    report FhpReport?

    images FhpImage[]
}

model FhpReport {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project   FtthProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
    projectId String      @unique @db.Uuid

    submitDate String

    xBoxes Int

    hubBoxes Int

    subBoxes Int

    endBoxes Int

    manholes Int

    closures Int

    metalPoles Int

    concretePoles Int

    feederLengthM Int

    distLengthM Int
}

enum FhpImageType {
    BOXES
    POLES
    CABLES
    MANHOLES
    TRENCHING
    POWER_TEST
}

model FhpImage {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    fhp   FtthProject @relation(fields: [fhpId], references: [id], onDelete: Cascade)
    fhpId String      @db.Uuid

    doc   WorkDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
    docId String  @db.Uuid

    type FhpImageType

    name String?

    takenAt DateTime?

    @@unique([fhpId, type, name], name: "uniq")
}

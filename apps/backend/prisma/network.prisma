model FtthArea {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    code String @unique

    name String @unique

    key String @unique

    locality   Locality @relation(fields: [localityId], references: [id])
    localityId String   @db.Uuid

    boundary   Boundary? @relation(fields: [boundaryId], references: [id])
    boundaryId String?   @unique @db.Uuid

    olts Olt[]

    surveys FtthSurvey[]

    connections FtthConnection[]
}

model Oem {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String @unique

    key String @unique

    olts Olt[]

    onts Ont[]

    boxes FtthBox[]
}

model Olt {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String @unique

    key String @unique

    ip String? @unique

    site String?

    oem   Oem    @relation(fields: [oemId], references: [id])
    oemId String @db.Uuid

    areas FtthArea[]

    boxes FtthBox[]

    homes FtthConnection[]
}

enum BoxType {
    X
    HUB
    SUB
    END
}

model FtthBox {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    type BoxType

    name String @unique

    serial String? @unique

    ports Int?

    oem   Oem    @relation(fields: [oemId], references: [id])
    oemId String @db.Uuid

    olt   Olt    @relation(fields: [oltId], references: [id])
    oltId String @db.Uuid

    coords   Coords? @relation(fields: [coordsId], references: [id])
    coordsId BigInt?

    boundary   Boundary? @relation(fields: [boundaryId], references: [id])
    boundaryId String?   @db.Uuid

    inCable Cable? @relation("in")

    outCables Cable[] @relation("out")

    connections FtthConnection[]
}

model Cable {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String? @unique

    /// [CoordsArray]
    line Json?

    length Int?

    toBox   FtthBox @relation(fields: [toBoxId], references: [id], name: "in")
    toBoxId String  @unique @db.Uuid

    fromBox   FtthBox? @relation(fields: [fromBoxId], references: [id], name: "out")
    fromBoxId String?  @db.Uuid
}

model Ont {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    serial String @unique

    model String?

    oem   Oem    @relation(fields: [oemId], references: [id])
    oemId String @db.Uuid

    fhc FtthConnection?
}

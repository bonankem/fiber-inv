model FtthConnection {
    id String @id @db.Uuid

    work Work @relation(fields: [id], references: [id])

    createdAt DateTime @default(now())

    tn String

    address String?

    email String?

    phone String?

    olt   Olt?    @relation(fields: [oltId], references: [id])
    oltId String? @db.Uuid

    fat   FtthBox? @relation(fields: [fatId], references: [id])
    fatId String?  @db.Uuid

    oltSlot Int?

    oltPort Int?

    fatPort Int?

    ontOem   Oem?    @relation(fields: [ontOemId], references: [id])
    ontOemId String? @db.Uuid

    ontSerial String? @unique

    cableLength Int?

    newPole Boolean?

    @@unique([fatId, fatPort], name: "fatUniq")
}

model FhcCostRule {
    id String @id @db.Uuid

    key String @unique

    minCableLength Int?

    maxCableLength Int?

    newPole Boolean?

    lines FhcCostLine[]
}

model FhcCostLine {
    id String @id @db.Uuid

    nameFr String @unique @db.Citext

    nameEn String? @unique @db.Citext

    ref String? @unique

    /// the cost line applies if *any* of the rules match
    rules FhcCostRule[]
}

enum WorkStatus {
    REQUESTED
    DECLINED
    ASSIGNED

    SURVEY
    INSTALLATION
    DESATURATION
    BUILDING_CABLING
    REVIEW
    CONFIGURATION
    FIELD_ATP
    FAILED_REVIEW
    FAILED_FIELD_ATP
    CANCELLED
    CLOSED
}

enum WorkAction {
    REQUEST
    DECLINE
    ASSIGN
    INITIATE
    COMMENT
    UPDATE

    FINISH_SURVEY
    UPDATE_STATUS
    UPLOAD_IMAGES
    SUBMIT_REPORT
    RESEND_REPORT

    FAIL_REVIEW
    PASS_REVIEW

    CONFIGURATION
    PASS_FIELD_ATP
    FAIL_FIELD_ATP
}

model Work {
    id String @id @default(uuid(7)) @db.Uuid

    sid String @unique

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String

    key String

    status WorkStatus

    statusSince DateTime @default(now())

    requestDate String

    startDate String?

    dueDate String?

    closeDate String?

    vendor   Vendor? @relation(fields: [vendorId], references: [id])
    vendorId String? @db.Uuid

    coords   Coords? @relation(fields: [coordsId], references: [id])
    coordsId BigInt?

    locality   Locality? @relation(fields: [localityId], references: [id])
    localityId String?   @db.Uuid

    workers Worker[]

    logs WorkLog[]

    docs WorkDoc[]

    fhs FtthSurvey?

    fhp FtthProject?

    fhc FtthConnection?
}

model Worker {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user   User   @relation(fields: [userId], references: [id])
    userId String @db.Uuid

    work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
    workId String @db.Uuid

    role StaffRole

    @@unique([workId, role], name: "uniq")
}

model WorkLog {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
    workId String @db.Uuid

    action WorkAction

    newStatus WorkStatus?

    fromUser   User?   @relation(fields: [fromUserId], references: [id])
    fromUserId String? @db.Uuid

    comment String?

    uploads Upload[]

    toNames String[]
}

enum WorkDocType {
    AREA_KMZ
    ODN_KMZ
    BOQ

    PLAN_DIAGRAM
    SYNOPTIC_DIAGRAM
    SURVEY_REPORT
    COORDINATES

    FHP_ODF
    FHP_TRENCHING
    FHP_BACKFILLING
    FHP_CLOSURE
    FHP_MANHOLE
    FHP_POLE
    FHP_BOX

    FHC_CABLE_AT_FAT
    FHC_CABLE_AT_CUSTOMER
    FHC_FAT_POWER_TEST
    FHC_ATB_POWER_TEST
    FHC_ONT_INDICATORS
    FHC_ONT_NAMEPLATE
    FHC_SPEED_TEST
    FHC_POLE

    // deprecated
    CABLE_LENGTHS
    SYNOPTIC_TABLE
    HP_SUMMARY
}

model WorkDoc {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
    workId String @db.Uuid

    type WorkDocType

    upload   Upload @relation(fields: [uploadId], references: [id])
    uploadId String @db.Uuid

    key String @default("")

    coords   Coords? @relation(fields: [coordsId], references: [id])
    coordsId BigInt?

    @@unique([workId, type, key], name: "uniq")
}

model FtthSurvey {
    id String @id @db.Uuid

    work Work @relation(fields: [id], references: [id])

    createdAt DateTime @default(now())

    boundary   Boundary? @relation(fields: [boundaryId], references: [id])
    boundaryId String?   @unique @db.Uuid

    contact String?

    isNewArea Boolean

    expectedHp Int?

    reportedHp Int?

    report FhsReport?

    projects FtthProject[]
}

model FhsReport {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    survey   FtthSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
    surveyId String     @unique @db.Uuid

    submitDate String

    hp Int

    olts Int

    oltCards Int

    xBoxes Int

    hubBoxes Int

    subBoxes Int

    endBoxes Int

    closures Int

    manholes Int

    metalPoles Int

    concretePoles Int

    transportLength Int

    distLength Int

    ductLength Int

    oldManholes Int

    oldPoles Int

    oldDuct Int
}

model FtthSurvey {
    id String @id @db.Uuid

    work Work @relation(fields: [id], references: [id])

    createdAt DateTime @default(now())

    boundary   Boundary? @relation(fields: [boundaryId], references: [id])
    boundaryId String?   @unique @db.Uuid

    area   FtthArea? @relation(fields: [areaId], references: [id])
    areaId String?   @db.Uuid

    newArea Boolean?

    contact String?

    proposedHp Int?

    reportedHp Int?

    report FhsReport?

    projects FtthProject[]
}

model FhsReport {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    survey   FtthSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
    surveyId String     @unique @db.Uuid

    submitDate String

    hp Int

    oltCards Int

    xBoxes Int

    hubBoxes Int

    subBoxes Int

    endBoxes Int

    closures Int

    manholes Int

    metalPoles Int

    concretePoles Int

    oldManholes Int

    oldPoles Int

    transportMetres Int

    distMetres Int
}

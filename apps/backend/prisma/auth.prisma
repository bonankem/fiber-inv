model Password {
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @unique @db.Uuid

    hashed String

    history String[]

    lastChange DateTime @default(now())

    mustChange Boolean
}

enum MfaMode {
    NONE
    EMAIL
    SMS
    WHATSAPP
    AUTHENTICATOR
    UNDECIDED
}

model Authenticator {
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @unique @db.Uuid

    secret String

    installed Boolean
}

enum OtpReason {
    LOGIN
    CHANGE_PASSWORD
}

model Otp {
    id String @id @default(uuid(7)) @db.Uuid

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @db.Uuid

    createdAt DateTime @default(now())

    expiresAt DateTime

    mode MfaMode

    reason OtpReason

    hashed String
}

model Session {
    id String @id @default(uuid(7)) @db.Uuid

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    replacedAt DateTime?

    expiresAt DateTime?

    hashed String
}

enum AuthAction {
    LOGIN_SUCCESS
    PASSWORD_FAILED
    OTP_FAILED
    LOCKOUT
    CHANGE_PASSWORD
    FORGOT_PASSWORD
    LOGOUT
    ADD_USER
    EXPIRED
    UNLOCKED_BY_ADMIN
}

model AuthLog {
    id String @id @default(uuid(7)) @db.Uuid

    time DateTime @default(now())

    action AuthAction

    ipAddress String

    email String @db.Citext

    userAgent String?

    country String?

    @@index([email])
}

model PasswordReset {
    email String @db.Citext

    key String @unique

    hashed String

    createdAt DateTime @default(now())

    expiresAt DateTime
}

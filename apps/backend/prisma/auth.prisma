model Password {
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @unique @db.Uuid

    hashed String

    history String[]

    lastChange DateTime @default(now())

    mustChange Boolean

    mfaMode MfaMode

    mfaVerified Boolean @default(false)
}

enum MfaMode {
    NONE
    EMAIL
    SMS
    WHATSAPP
    AUTHENTICATOR
    UNDECIDED
}

model Authenticator {
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @unique @db.Uuid

    secret String

    installed Boolean
}

model Otp {
    id String @id @default(uuid(7)) @db.Uuid

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @db.Uuid

    createdAt DateTime @default(now())

    mode MfaMode

    hashed String
}

model Session {
    id String @id @default(uuid(7)) @db.Uuid

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId String @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    expiry DateTime

    hashed String
}

enum AuthAction {
    LOGIN_SUCCESS
    PASSWORD_FAILED
    OTP_FAILED
    FORGOT_PASSWORD
    CHANGE_PASSWORD
    RESET_PASSWORD
    LOGOUT
}

model AuthLog {
    id String @id @default(uuid(7)) @db.Uuid

    time DateTime @default(now())

    action AuthAction

    ipAddress String

    userAgent String

    email String @db.Citext

    country String?

    @@index([email])
}

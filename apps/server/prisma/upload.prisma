model Upload {
    id String @id @default(uuid(7)) @db.Uuid

    name String

    type String

    size Int

    sentAt DateTime @default(now())

    madeAt DateTime?

    parsed Json?

    inDb UploadInDb?

    workLogs WorkLog[]

    workDocs WorkDoc[]
}

model UploadInDb {
    upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
    uploadId String @unique @db.Uuid

    data Bytes
}

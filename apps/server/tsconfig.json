{
  "include": ["src/**/*"],
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": false,
    "paths": { "#/*": ["./src/*"] },
    "moduleResolution": "bundler",

    // Environment Settings
    "module": "esnext",
    "target": "es2024",
    "lib": ["ES2024"],
    "types": ["node"],

    // Recommended Options
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  },
  "tsc-alias": {
    "resolveFullPaths": true
  }
}

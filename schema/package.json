{
  "name": "schema",
  "type": "module",
  "exports": {
    "./*": "./dist/*/index.js",
    "./enums": "./dist/generated/enums.js"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:expose": "nodemon",
    "build": "rm -rf dist && tsc && tsc-alias",
    "turbo-build": "pnpm -w build:schema",
    "refresh-dev": "touch ../server/src/main.ts ../web/src/main.tsx"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "zod": "^4.3.6"
  },
  "nodemonConfig": {
    "watch": "src",
    "ext": "ts",
    "exec": "pnpm turbo-build && pnpm refresh-dev"
  }
}

{
  "name": "schema",
  "type": "module",
  "exports": {
    "./*": "./dist/*/index.js",
    "./enums": "./dist/generated/enums.js"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:host": "nodemon",
    "build": "rm -rf dist && tsc && tsc-alias"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "zod": "^4.3.6"
  },
  "nodemonConfig": {
    "watch": "src",
    "ext": "ts",
    "exec": "pnpm build && touch ../server/src/main.ts ../web/src/main.tsx",
    "comment": [
      "During pnpm dev, rebuilding schema can cause its dependants to throw errors,",
      "so we touch files in each module to reset their states and clear the errors."
    ]
  }
}

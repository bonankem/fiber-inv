model Coords {
    id  BigInt @id
    lat Float
    lng Float

    works Work[]

    fhsBoxes FhsBox[]
}

model Boundary {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    /// [LinearRingJson]
    ring Json

    // bounding box
    north Float
    south Float
    east  Float
    west  Float

    locality Locality?

    fhs FtthSurvey?

    plaque Plaque?

    box Box?
}

model District {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String @unique

    key String @unique

    localities Locality[]
}

model Locality {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String @unique

    key String @unique

    district   District @relation(fields: [districtId], references: [id])
    districtId String   @db.Uuid

    boundary   Boundary? @relation(fields: [boundaryId], references: [id])
    boundaryId String?   @unique @db.Uuid

    works Work[]

    plaques Plaque[]
}

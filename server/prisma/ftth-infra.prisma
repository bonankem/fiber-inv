model Plaque {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String

    locality   Locality? @relation(fields: [localityId], references: [id])
    localityId String?   @db.Uuid

    boundary   Boundary? @relation(fields: [boundaryId], references: [id])
    boundaryId String?   @unique @db.Uuid

    hubs Box[]

    connections FtthConnection[]
}

model Oem {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String

    olts Olt[]

    hubs Box[]
    onts Ont[]
}

model Olt {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String

    ip String? @unique

    oem   Oem    @relation(fields: [oemId], references: [id])
    oemId String @db.Uuid

    boxes Box[]

    fhc FtthConnection[]
}

enum BoxType {
    X_BOX
    HUB_BOX
    SUB_BOX
    END_BOX
}

model Box {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String @unique

    serial String? @unique

    oem   Oem    @relation(fields: [oemId], references: [id])
    oemId String @db.Uuid

    olt   Olt?    @relation(fields: [oltId], references: [id])
    oltId String? @db.Uuid

    plaque   Plaque? @relation(fields: [plaqueId], references: [id])
    plaqueId String? @db.Uuid

    boundary   Boundary? @relation(fields: [boundaryId], references: [id])
    boundaryId String?   @unique @db.Uuid

    fhc FtthConnection[]
}

model Ont {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    serial String @unique

    model String?

    oem   Oem    @relation(fields: [oemId], references: [id])
    oemId String @db.Uuid

    fhc FtthConnection?
}

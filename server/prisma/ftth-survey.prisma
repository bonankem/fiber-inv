model FtthSurvey {
    id String @id @db.Uuid

    work Work @relation(fields: [id], references: [id])

    createdAt DateTime @default(now())

    boundary   Boundary? @relation(fields: [boundaryId], references: [id])
    boundaryId String?   @unique @db.Uuid

    contact String?

    oltCode String?

    proposedHp Int?

    reportedHp Int?

    report FhsReport?

    boxes FhsBox[]

    projects FtthProject[]
}

model FhsReport {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    survey   FtthSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
    surveyId String     @unique @db.Uuid

    submitDate String

    hp Int

    oltCards Int

    xBoxes Int

    hubBoxes Int

    subBoxes Int

    endBoxes Int

    manholes Int

    closures Int

    metalPoles Int

    concretePoles Int

    feederLengthM Int

    distLengthM Int
}

model FhsBox {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    survey   FtthSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
    surveyId String     @db.Uuid

    type BoxType

    name String

    hp Int?

    coords   Coords @relation(fields: [coordsId], references: [id])
    coordsId BigInt

    @@unique([surveyId, name], name: "uniq")
}

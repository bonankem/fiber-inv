generator client {
  provider        = "prisma-client"
  output          = "../src/prisma/generated"
  previewFeatures = ["postgresqlExtensions"]
}

generator schema {
  provider        = "prisma-client"
  output          = "../../schema/src/generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, postgis]
}

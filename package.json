{
  "name": "servicex-mtnci",
  "version": "1.0.0",
  "description": "ServiceX for MTN Côte d'Ivoire",
  "author": "Zoracom",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.8.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.1.2",
    "lefthook": "^2.1.10",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "turbo build",
    "clean": "rm -rf */dist",
    "prisma": "pnpm -F backend exec prisma",
    "prisma:sync": "pnpm prisma generate && pnpm prisma db push && pnpm build --filter schema --force",
    "build:schema": "turbo --filter schema build",
    "dev": "pnpm build:schema && turbo dev --ui tui",
    "dev:expose": "pnpm build:schema && turbo dev:expose --ui tui",
    "heroku-db": "pnpm prisma generate",
    "heroku-postbuild": "pnpm heroku-db && turbo build --filter backend --force"
  }
}

{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/generated/**"],
      "outputs": ["dist/**", "src/paraglide/**", "project.inlang/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:expose": {
      "cache": false,
      "persistent": true
    }
  }
}

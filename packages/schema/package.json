{
  "name": "schema",
  "type": "module",
  "exports": {
    "./enums": "./dist/prisma/generated/enums.js",
    "./prisma.client": "./dist/prisma.client.js",
    "./errors": "./dist/errors.js",
    "./utils": "./dist/utils.js",
    "./*": "./dist/*/index.js"
  },
  "scripts": {
    "dev": "nodemon",
    "dev:expose": "nodemon",
    "build": "node ../../scripts/build.mjs",
    "turbo-build": "pnpm -w build:schema",
    "refresh-dev": "cd ../../apps && touch backend/src/main.ts web/src/main.tsx"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "zod": "^4.3.6"
  },
  "nodemonConfig": {
    "watch": "src",
    "ext": "ts",
    "exec": "pnpm turbo-build && pnpm refresh-dev",
    "delay": 0.5
  }
}

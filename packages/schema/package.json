{
  "name": "schema",
  "type": "module",
  "exports": {
    "./*": "./dist/*/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && tsc-alias",
    "dev": "nodemon"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "zod": "^4.3.6"
  },
  "nodemonConfig": {
    "ext": "ts",
    "watch": "src",
    "exec": "pnpm build && touch ../../apps/server/src/main.ts",
    "comment": [
      "During pnpm dev, changes to schema can cause server to raise an error,",
      "so we touch main.ts to refresh the server state and clear the error."
    ]
  }
}

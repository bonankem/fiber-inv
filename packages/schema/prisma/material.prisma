model Equipment {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String

    description String

    mtnCode String @unique

    ifsCode String

    partNumber String

    available Int @default(0)

    dateSynced String

    emrfItems EmrfItem[]
}

model Emrf {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    status EmrfStatus

    items EmrfItem[]

    orderNumber String?
}

model EmrfItem {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    emrf   Emrf   @relation(fields: [emrfId], references: [id])
    emrfId String @db.Uuid

    segment String

    equipment   Equipment @relation(fields: [equipmentId], references: [id])
    equipmentId String    @db.Uuid

    position Int @default(0)

    requestedQty Int

    collectedQty Int @default(0)
}

enum EmrfStatus {
    REQUESTED
    ORDERED
    COLLECTED
    CANCELLED
}

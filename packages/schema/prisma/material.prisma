model Equipment {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    name String

    mtnCode String

    ifsCode String

    partNumber String

    available Int @default(0)

    dateSynced String?

    emrfItems EmrfItem[]
}

model Emrf {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    status EmrfStatus

    items EmrfItem[]
}

model EmrfItem {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    emrf   Emrf   @relation(fields: [emrfId], references: [id])
    emrfId String @db.Uuid

    equipment   Equipment @relation(fields: [equipmentId], references: [id])
    equipmentId String    @db.Uuid

    quantity Int @default(0)

    position Int @default(0)
}

enum EmrfStatus {
    REQUESTED
    CANCELLED
    SHIPPED
    COLLECTED
}

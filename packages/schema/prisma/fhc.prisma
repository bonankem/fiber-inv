model FtthConnection {
    id String @id @db.Uuid

    work Work @relation(fields: [id], references: [id])

    createdAt DateTime @default(now())

    tn String

    email String?

    phone String?

    mode FhcMode?

    withPole Boolean?

    distance Int?

    olt   Olt?    @relation(fields: [oltId], references: [id])
    oltId String? @db.Uuid

    fat   Fat?    @relation(fields: [fatId], references: [id])
    fatId String? @db.Uuid

    oltSlot Int?

    oltPort Int?

    fatPort Int?

    ontOem   Oem?    @relation(fields: [ontOemId], references: [id])
    ontOemId String? @db.Uuid

    ontSerial String? @unique

    costCategory FhcCostCategory?

    totalCost Float?

    costItems FhcCostItem[]
}

enum FhcMode {
    CABLED_BUILDING
    PRECONNECTORIZED
    TRADITIONAL
}

/// The different cost categories, determined by mode of cabling and distance.
/// For `PRICE_BOOK`, the cost is determined by the selected cost items (`FhcCostItem`).
/// For other categories, there is a fixed price per vendor (`FhcFixedPrice`).
enum FhcCostCategory {
    /// cabled building
    CABLED_BUILDING
    /// traditional, distance ≤ 100m, no pole
    TRAD_100
    /// traditional, distance > 100m ≤ 300m, no pole
    TRAD_300
    /// preconnectorized, distance ≤ 100m, no pole
    PRECON_100
    /// preconnectorized, distance > 100m ≤ 300m, no pole
    PRECON_300
    /// distance > 300m, or with pole
    PRICE_BOOK
}

/// A cost item for a home connection that falls under `FhcCostCategory.PRICE_BOOK`.
/// Each cost item is associated with a line in the price book (`FhcPbLine`), and
/// the cost is determined by the price for the vendor (`FhcLinePrice`).
model FhcCostItem {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    work   FtthConnection @relation(fields: [workId], references: [id])
    workId String         @db.Uuid

    line   FhcPbLine @relation(fields: [lineId], references: [id])
    lineId String    @db.Uuid

    cost Float
}

/// The fixed price per vendor for home connections that
/// do not fall under `FhcCostCategory.PRICE_BOOK`.
model FhcFixedPrice {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    category FhcCostCategory

    vendor   Vendor @relation(fields: [vendorId], references: [id])
    vendorId String @db.Uuid
}

/// A line in the price book that can be included in home connection costs.
model FhcPbLine {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    ref String @unique

    nameFr String @unique @db.Citext

    nameEn String @unique @db.Citext

    prices FhcLinePrice[]

    items FhcCostItem[]
}

/// The price of a line in the price book for a specific vendor.
model FhcLinePrice {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    line   FhcPbLine @relation(fields: [lineId], references: [id])
    lineId String    @db.Uuid

    vendor   Vendor @relation(fields: [vendorId], references: [id])
    vendorId String @db.Uuid

    price Float
}

model FtthConnection {
    id String @id @db.Uuid

    work Work @relation(fields: [id], references: [id])

    createdAt DateTime @default(now())

    tn String

    email String?

    phone String?

    mode FhcMode?

    withPole Boolean?

    distance Int?

    olt   Olt?    @relation(fields: [oltId], references: [id])
    oltId String? @db.Uuid

    fat   Fat?    @relation(fields: [fatId], references: [id])
    fatId String? @db.Uuid

    oltSlot Int?

    oltPort Int?

    fatPort Int?

    ontOem   Oem?    @relation(fields: [ontOemId], references: [id])
    ontOemId String? @db.Uuid

    ontSerial String? @unique

    costCategory FhcCostCategory?

    totalCost Float?

    quantities FhcQuantity[]

    @@unique([fatId, fatPort], name: "fatUniq")
}

enum FhcMode {
    CABLED_BUILDING
    PRECONNECTORIZED
    TRADITIONAL
}

/// The different cost categories, determined by mode of cabling and distance.
/// For `PRICE_BOOK`, the cost is determined by the quantities (`FhcQuantity`).
/// For other categories, there is a fixed price per vendor (`FhcFixedPrice`).
enum FhcCostCategory {
    /// cabled building
    CABLED_BUILDING
    /// traditional, distance ≤ 100m, no pole
    TRAD_100
    /// traditional, distance > 100m ≤ 300m, no pole
    TRAD_300
    /// preconnectorized, distance ≤ 100m, no pole
    PRECON_100
    /// preconnectorized, distance > 100m ≤ 300m, no pole
    PRECON_300
    /// distance > 300m, or with pole
    PRICE_BOOK
}

/// A quantity of a price book line item used for a home connection.
/// Each quantity is associated with a item in the price book (`FhcPbItem`), and
/// the cost is determined by the price for the vendor (`FhcLinePrice`).
model FhcQuantity {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    work   FtthConnection @relation(fields: [workId], references: [id], onDelete: Cascade)
    workId String         @db.Uuid

    item   FhcPbItem @relation(fields: [itemId], references: [id])
    itemId String    @db.Uuid

    quantity Int

    cost Float?

    @@unique([workId, itemId], name: "uniq")
}

/// The fixed price per vendor for home connections that
/// do not fall under `FhcCostCategory.PRICE_BOOK`.
model FhcFixedPrice {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    category FhcCostCategory

    vendor   Vendor @relation(fields: [vendorId], references: [id])
    vendorId String @db.Uuid
}

/// A line item in the price book that can be included in home connection costs.
model FhcPbItem {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    ref String @unique

    nameFr String @unique @db.Citext

    nameEn String @unique @db.Citext

    prices FhcItemPrice[]

    items FhcQuantity[]
}

/// The price of a line item in the price book for a specific vendor.
model FhcItemPrice {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    item   FhcPbItem @relation(fields: [itemId], references: [id])
    itemId String    @db.Uuid

    vendor   Vendor @relation(fields: [vendorId], references: [id])
    vendorId String @db.Uuid

    price Float
}

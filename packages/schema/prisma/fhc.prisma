model FtthConnection {
    id String @id @db.Uuid

    work Work @relation(fields: [id], references: [id])

    createdAt DateTime @default(now())

    tn String

    address String?

    email String?

    phone String?

    olt   Olt?    @relation(fields: [oltId], references: [id])
    oltId String? @db.Uuid

    fat   FtthBox? @relation(fields: [fatId], references: [id])
    fatId String?  @db.Uuid

    oltSlot Int?

    oltPort Int?

    fatPort Int?

    ontOem   Oem?    @relation(fields: [ontOemId], references: [id])
    ontOemId String? @db.Uuid

    ontSerial String? @unique

    cableLength Int?

    newPole Boolean?

    @@unique([fatId, fatPort], name: "fatUniq")
}

model FhcCostRule {
    id String @id @default(uuid(7)) @db.Uuid

    /// the name used to identify this rule
    name String @unique

    /// cable length > this
    minCable Int

    /// cable length <= this (0 means no limit)
    maxCable Int

    /// 0=without pole, 1=with pole, 2=both cases
    usesPole Int

    /// cost lines that use this rule
    lines FhcCostLine[]

    @@unique([minCable, maxCable, usesPole], name: "uniq")
}

model FhcCostLine {
    id String @id @default(uuid(7)) @db.Uuid

    /// the name in Français
    nameFr String @unique @db.Citext

    /// the name in English
    nameEn String? @unique @db.Citext

    /// the unique ref that MTN uses to identify this line
    ref String? @unique

    /// the ordered position of this line
    ord Int @default(0)

    /// the cost line applies if any of these rules match
    rules FhcCostRule[]

    /// the price to apply if a vendor does not have their own price
    defaultPrice Float?

    /// the price of this line for each vendor
    vendorPrices FhcVendorPrice[]
}

model FhcVendorPrice {
    id String @id @default(uuid(7)) @db.Uuid

    /// the cost line that carries this price
    line   FhcCostLine @relation(fields: [lineId], references: [id])
    lineId String      @db.Uuid

    /// the vendor to which this price applies
    vendor   Vendor @relation(fields: [vendorId], references: [id])
    vendorId String @db.Uuid

    /// the price to apply
    price Float
}

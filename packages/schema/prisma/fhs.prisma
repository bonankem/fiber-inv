model FtthSurvey {
    id String @id @db.Uuid

    work Work @relation(fields: [id], references: [id])

    createdAt DateTime @default(now())

    boundary   Boundary? @relation(fields: [boundaryId], references: [id])
    boundaryId String?   @unique @db.Uuid

    contact String?

    area String?

    expectedHp Int?

    reportedHp Int?

    hp Int?

    clusters Int?

    report FhsReport?

    quantity FhsQuantity?

    projects FtthProject[]
}

model FhsQuantity {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    survey   FtthSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
    surveyId String     @unique @db.Uuid

    xBoxes Int

    hubBoxes Int

    fats Int

    closures Int

    manholes Int

    metalPoles Int

    concretePoles Int

    transportLength Int

    distLength Int
}

model FhsReport {
    id String @id @default(uuid(7)) @db.Uuid

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    survey   FtthSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
    surveyId String     @unique @db.Uuid

    submitDate String

    hp Int

    oltCards Int

    xBoxes Int

    hubBoxes Int @default(0)

    fats Int @default(0)

    closures Int

    manholes Int

    metalPoles Int

    concretePoles Int

    transportLength Int

    distLength Int
}

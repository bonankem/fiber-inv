{
  "name": "i18n",
  "version": "1.0.0",
  "description": "",
  "exports": {
    "./messages": "./src/paraglide/messages.js",
    "./runtime": "./src/paraglide/runtime.js"
  },
  "scripts": {
    "dev": "pnpm build --watch",
    "dev:expose": "pnpm build --watch",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy localStorage preferredLanguage baseLocale",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "devDependencies": {
    "@inlang/cli": "^3.3.0",
    "@inlang/paraglide-js": "^2.23.0"
  },
  "nodemonConfig": {
    "watch": "messages",
    "ext": "json",
    "exec": "pnpm build"
  }
}
